{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MoaidHathot/MHX/main/schemas/mhx.schema.json",
  "title": "MHX profile v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1, "default": 1 },
    "kind": { "enum": ["command", "dotnet-tool"], "default": "command" },
    "command": { "type": "string", "minLength": 1 },
    "arguments": { "type": "array", "maxItems": 4096, "items": { "type": "string" } },
    "workingDirectory": { "type": "string", "minLength": 1 },
    "inheritEnvironment": { "type": "boolean", "default": true },
    "environment": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
    "dotnet": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "nugetConfig": { "type": "string", "minLength": 1 }
  },
  "if": { "required": ["kind"], "properties": { "kind": { "const": "dotnet-tool" } } },
  "then": { "not": { "required": ["command"] } },
  "else": {
    "required": ["command"],
    "not": { "anyOf": [{ "required": ["dotnet"] }, { "required": ["sources"] }, { "required": ["nugetConfig"] }] }
  }
}
